# =========================
# Secrets
# =========================
OPENAI_API_KEY=your-openai-api-key-here

# Shared secret between the clients and the backend (X-API-Key header).
# Leave empty to disable API authentication (development only!).
BACKEND_API_KEY=change-me-to-a-long-random-string

# Telegram bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# =========================
# LLM / retrieval
# =========================
MODEL_NAME=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
TEMPERATURE=0
TOP_K_RESULTS=5
# Cosine similarity a retrieved chunk must reach to be used, 0.0-1.0.
# 0 keeps every candidate. Raise it only after looking at the per-query
# "retrieval ... similarity_best=... similarity_worst=..." log lines: the right
# value depends on your corpus and embedding model, and setting it too high
# silently drops relevant context.
RELEVANCE_THRESHOLD=0
# Past exchanges a follow-up question may draw on. Each turn adds prompt
# tokens, and a follow-up costs one extra model call to rewrite it as a
# standalone question. 0 disables multi-turn behaviour.
MAX_HISTORY_TURNS=6
# Diversity of retrieved chunks, 0.0-1.0. 1.0 ranks by relevance alone; lower
# values cover more passages instead of several chunks of the same one.
# Ships at 1.0 because the trade is not free - see DOCUMENTATION for the
# measured numbers before changing it.
MMR_LAMBDA=1.0
# Cap on generated answer length. Without one the model can produce an
# unbounded completion at the operator's expense.
MAX_ANSWER_TOKENS=1000

# =========================
# OpenAI transport
# =========================
# The SDK's own default is a 600 s read timeout, far longer than any client
# waits. Keep this below the clients' timeouts (the bot waits 120 s).
OPENAI_TIMEOUT=45
OPENAI_MAX_RETRIES=2
# Set for Azure OpenAI or an OpenAI-compatible endpoint (vLLM, Ollama).
# Leave empty for api.openai.com.
OPENAI_BASE_URL=

# =========================
# Chunking
# =========================
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# =========================
# Storage
# =========================
CHROMA_PERSIST_DIR=./data/chroma_db
COLLECTION_NAME=documents
UPLOAD_DIR=data/uploads
# Maximum accepted upload size, in bytes (default 30 MB)
MAX_FILE_SIZE=31457280

# =========================
# Answer feedback
# =========================
# Ratings are stored only when a user presses a button, but the record does
# contain their question and the answer. Set to false to collect nothing; the
# endpoint then answers 404 and the clients draw no buttons.
FEEDBACK_ENABLED=true
FEEDBACK_DIR=data/feedback
# Append-only and never rotated automatically. At the cap, new ratings are
# refused (HTTP 507) rather than filling the volume the vector store lives on;
# move the file aside to start a fresh one.
FEEDBACK_MAX_BYTES=10485760

# =========================
# Clients
# =========================
# Overridden to http://backend:8000 in docker-compose
BACKEND_URL=http://localhost:8000
